// Coi Built-in String Type
// This file defines mappings for string methods

@builtin
type string {
    // String methods - these inline directly to webcc::string methods
    @inline("${this}.length()")
    def length(): int

    // the byte at index, 0-255
    @inline("(int32_t)(uint8_t)(${this}[${0}])")
    def charAt(int index): int

    @inline("${this}.at(${0})")
    def at(int index): string

    @inline("${this}.substr(${0})")
    def subStr(int start): string

    @inline("${this}.substr(${0}, ${1})")
    def subStr(int start, int length): string

    @inline("${this}.contains(${0})")
    def contains(string needle): bool

    @inline("${this}.empty()")
    def isEmpty(): bool

    @inline("${this}.trim()")
    def trim(): string

    @inline("${this}.trim_start()")
    def trimStart(): string

    @inline("${this}.trim_end()")
    def trimEnd(): string

    @inline("coi::to_int(${this})")
    def toInt(): int

    @inline("coi::to_float(${this})")
    def toFloat(): float

    @inline("coi::to_string(${this})")
    def toString(): string

    @inline("${this} += ${0}")
    def append(string suffix): void

    // UTF-8
    @inline("coi::string_to_bytes(${this})")
    def toBytes(): uint8[]

    @inline("coi::string_from_bytes(${0})")
    shared def fromBytes(uint8[] bytes): string
}
