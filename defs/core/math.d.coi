// Coi Math Library
// Provides mathematical functions and constants

type Math {
    // Constants
    @inline("coi::math::PI")
    shared float PI;

    @inline("coi::math::HALF_PI")
    shared float HALF_PI;

    @inline("coi::math::TAU")
    shared float TAU;

    @inline("coi::math::DEG2RAD")
    shared float DEG2RAD;

    @inline("coi::math::RAD2DEG")
    shared float RAD2DEG;

    @inline("coi::math::E")
    shared float E;

    // Basic
    @inline("coi::math::abs(${0})")
    shared def abs(float x) : float

    @inline("coi::math::sqrt(${0})")
    shared def sqrt(float x) : float

    @inline("coi::math::pow(${0}, ${1})")
    shared def pow(float base, float exponent) : float

    @inline("coi::math::exp(${0})")
    shared def exp(float x) : float

    @inline("coi::math::log(${0})")
    shared def log(float x) : float

    @inline("coi::math::log2(${0})")
    shared def log2(float x) : float

    @inline("coi::math::log10(${0})")
    shared def log10(float x) : float

    @inline("coi::math::hypot(${0}, ${1})")
    shared def hypot(float x, float y) : float

    // Trigonometric
    @inline("coi::math::sin(${0})")
    shared def sin(float x) : float

    @inline("coi::math::cos(${0})")
    shared def cos(float x) : float

    @inline("coi::math::tan(${0})")
    shared def tan(float x) : float

    @inline("coi::math::asin(${0})")
    shared def asin(float x) : float

    @inline("coi::math::acos(${0})")
    shared def acos(float x) : float

    @inline("coi::math::atan(${0})")
    shared def atan(float x) : float

    @inline("coi::math::atan2(${0}, ${1})")
    shared def atan2(float y, float x) : float

    // Rounding
    @inline("coi::math::floor(${0})")
    shared def floor(float x) : float

    @inline("coi::math::ceil(${0})")
    shared def ceil(float x) : float

    @inline("coi::math::round(${0})")
    shared def round(float x) : float

    @inline("coi::math::trunc(${0})")
    shared def trunc(float x) : float

    // Utility
    @inline("coi::math::min(${0}, ${1})")
    shared def min(float a, float b) : float

    @inline("coi::math::max(${0}, ${1})")
    shared def max(float a, float b) : float

    @inline("coi::math::clamp(${0}, ${1}, ${2})")
    shared def clamp(float value, float min, float max) : float

    @inline("coi::math::lerp(${0}, ${1}, ${2})")
    shared def lerp(float a, float b, float t) : float

    // Random
    @intrinsic("random")
    shared def random(): float

    @intrinsic("random_seeded")
    shared def random(int seed): float
}
