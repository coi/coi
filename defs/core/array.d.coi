// Coi Built-in Array Types
// This file defines mappings for both dynamic and fixed-size arrays

// Dynamic array (T[]) - maps to webcc::vector<T>
@builtin
type array<T> {
    @inline("${this}.push_back(${0})")
    def push(T value): void

    @inline("${this}.pop_back()")
    def pop(): void

    @inline("(int)${this}.size()")
    def size(): int

    @inline("${this}.clear()")
    def clear(): void

    @inline("${this}.reserve(${0})")
    def reserve(int capacity): void

    @inline("${this}.empty()")
    def isEmpty(): bool

    @inline("${this}.index_of(${0})")
    def indexOf(T value): int

    @inline("${this}.contains(${0})")
    def contains(T value): bool

        @inline("${this}.remove(${0})")
    def remove(int index): void

    @inline("${this}.sort()")
    def sort(): void

    // adds every element of other
    @inline("coi_append(${this}, ${0})")
    def append(T[] other): void

    // count elements from start
    @inline("coi_slice(${this}, ${0}, ${1})")
    def slice(int start, int count): T[]

    // from start to the end
    @inline("coi_slice(${this}, ${0}, -1)")
    def slice(int start): T[]

    // with an inline function (b => b.id == 7): indexOf, contains and remove take it under
    // these names; the compiler picks them when the argument is one
    @inline("coi_index_where(${this}, ${0})")
    def indexOfWhere(def pred(T): bool): int

    @inline("coi_any(${this}, ${0})")
    def containsWhere(def pred(T): bool): bool

    @inline("coi_remove_where(${this}, ${0})")
    def removeWhere(def pred(T): bool): void

    @inline("coi_filter(${this}, ${0})")
    def filter(def pred(T): bool): T[]

    @inline("coi_count_where(${this}, ${0})")
    def count(def pred(T): bool): int

    @inline("coi_any(${this}, ${0})")
    def any(def pred(T): bool): bool

    @inline("coi_all(${this}, ${0})")
    def all(def pred(T): bool): bool
}

// Fixed-size array (T[N]) - maps to webcc::array<T, N>
@builtin
type array<T, N> {
    @inline("(int)${this}.size()")
    def size(): int

    @inline("${this}.empty()")
    def isEmpty(): bool

    @inline("${this}.index_of(${0})")
    def indexOf(T value): int

    @inline("${this}.contains(${0})")
    def contains(T value): bool

        @inline("${this}.fill(${0})")
    def fill(T value): void

    @inline("${this}.sort()")
    def sort(): void

    @inline("coi_index_where(${this}, ${0})")
    def indexOfWhere(def pred(T): bool): int

    @inline("coi_any(${this}, ${0})")
    def containsWhere(def pred(T): bool): bool

    @inline("coi_count_where(${this}, ${0})")
    def count(def pred(T): bool): int

    @inline("coi_any(${this}, ${0})")
    def any(def pred(T): bool): bool

    @inline("coi_all(${this}, ${0})")
    def all(def pred(T): bool): bool
}
