// schema_whitelist.def
// Purpose: Explicitly allow these WebCC functions to be exposed to Coi
// This is the "single source of truth" for the public Coi API.
//
// Format:
//   [namespace]
//   [Type]                     - @intrinsic/@inline definitions for one handle type only (uppercase = type)
//   function_name              - Regular webcc function (auto-generates @map)
//   // comment                 - Preserved comment (emitted before next @intrinsic/@inline)
//   @intrinsic("x") def ...    - Raw intrinsic definition (emitted as-is)
//   @inline("x") def ...       - Raw inline definition (emitted as-is)

[dom]
# Event listeners. +listen makes their events view attributes (onpointerdown=, onwheel=...);
# the view calls them with these values: pointer capture, and the page doesn't scroll under
# a wheel handler. An element sets its own pointer flags with pointerflags={...}.
remove_pointer_listener
add_pointer_listener +listen(POINTER) flags=1
add_wheel_listener +listen(WHEEL) prevent_default=1
observe_resize +listen(RESIZE)
add_focus_listener +listen(FOCUS, BLUR)
add_drop_listener +listen(DROP)
# Text boxes over a canvas: move one, focus it, read what was typed (innerText)
set_style
focus
blur
get_property
request_fullscreen
request_pointer_lock
scroll_to_top

[canvas]
create_canvas
get_context_webgl
get_context_webgpu
set_size
free
log_canvas_info
set_fill_style
set_fill_style_str
fill_rect
clear_rect
stroke_rect
set_stroke_style
set_stroke_style_str
set_line_width
begin_path
close_path
move_to
line_to
stroke
fill
arc
fill_text
fill_text_f
fill_text_i
set_font
set_text_align
draw_image
translate
rotate
scale
save
restore
set_global_alpha
set_line_cap
set_line_join
set_shadow
bezier_curve_to
quadratic_curve_to
rect
clip
stroke_text
set_text_baseline
draw_image_scaled
draw_image_full
set_global_composite_operation
transform
set_miter_limit
set_image_smoothing_enabled
measure_text_width
measure_text
ellipse
arc_to
set_line_dash
get_line_dash
reset_transform
set_transform

[audio]
create_audio
play
pause
set_volume
set_loop
get_current_time
get_duration

[image]
# LOADED (size, after decoding) or ERROR; from_blob for pasted, dropped or stored bytes
load +events
from_blob +events
free

[input]
exit_pointer_lock
# Shortcuts: stop the browser's own action for a key combination (Ctrl+S saves the page)
prevent_key
allow_key
# Key events for Input.onKeyDown(&h) / onKeyUp
init_keyboard +listen(KEY_DOWN, KEY_UP)
// Keyboard state queries (compiler intrinsics)
@intrinsic("key_down") shared def isKeyDown(int keyCode): bool
@intrinsic("key_up") shared def isKeyUp(int keyCode): bool

[storage]
set_item
get_item
remove_item
clear

[fetch]
# Text requests; DONE is only for request() (needs bytes), so it is left out here
get +events(SUCCESS, ERROR)
post +events(SUCCESS, ERROR)
patch +events(SUCCESS, ERROR)
# Any method, binary body; DONE has the status and the body as a Blob
request +events(DONE, ERROR)
abort

[system]
# Frames on demand (app { tick = demand; }), screen and connection
get_device_pixel_ratio
is_online
# Page lifecycle for System.onPageHide(&h) etc.; save on visibility hidden, PAGE_HIDE is the last chance
init_lifecycle +listen(PAGE_HIDE, PAGE_SHOW, ONLINE)
init_visibility_change +listen(VISIBILITY_CHANGE)
log
warn
error
set_title
reload
open_url
get_time
get_date_now
get_timezone_offset_ms
get_pathname
get_search
get_query_param
get_visibility_state
# Frames on demand: with app { tick = demand; } tick runs once per requested frame
request_frame
@intrinsic("is_hidden") shared def isHidden(): bool
// Router navigation (compiler intrinsics)
@intrinsic("navigate") shared def navigate(string route): void
@intrinsic("get_route") shared def getRoute(): string

[webgl]
viewport
clear_color
clear
create_shader
create_program
attach_shader
link_program
bind_attrib_location
use_program
create_buffer
bind_buffer
buffer_data
enable_vertex_attrib_array
enable
get_uniform_location
uniform_1f
vertex_attrib_pointer
draw_arrays

[Canvas]
// 2D context. lowLatency: the canvas may reach the screen without waiting for the page (less pen lag), opaque: no transparency, a bit faster
@inline("webcc::canvas::get_context_2d(${this})") def getContext2d(): CanvasContext2D
@inline("webcc::canvas::get_context_2d(${this}, webcc::canvas::ContextFlags((${0} ? 1 : 0) | (${1} ? 2 : 0)))") def getContext2d(bool lowLatency, bool opaque): CanvasContext2D

[blob]
# Bytes held on the JS side (an IndexedDB value, a pasted image): read() keeps them, take() frees
create
size
read
take
free

[idb]
# Key-value storage: string keys, uint8[] values. Results arrive on the returned request
open +events
put +events(DONE, ERROR)
get +events(VALUE, ERROR)
remove +events(DONE, ERROR)
keys +events(KEYS, ERROR)
close

[clipboard]
# write_text only works in a click or key handler
write_text
# Pastes outside text fields; inputs keep their native paste
init_paste +listen(PASTE_TEXT, PASTE_IMAGE) prevent_default=1

[files]
# open shows the file dialog (in a click or key handler); one OPENED per picked file
open +events
save

[pdf]
# Import (pdf.js, shipped by the app: Pdf.setLibrary first) and export
set_library
open +events
page_width
page_height
render_page +events
cancel_render
close
create_writer +events
add_page
set_stroke_color
set_fill_color
set_line_width
set_line_cap
set_line_join
move_to
line_to
quad_to
curve_to
rect
close_path
stroke
fill
save
restore
draw_image
draw_text
finish

[websocket]
# An owned socket member is closed when its component is destroyed
@cleanup("websocket::close")
connect +events
send
close
get_ready_state
send_binary
close_with_code
get_buffered_amount
get_protocol
get_extensions
get_url
// True while the socket is open (not connecting, closing or closed)
@inline("(webcc::websocket::get_ready_state($self) == webcc::websocket::ReadyState::OPEN)") def isConnected(): bool

[wgpu]
request_adapter
request_device
configure
get_current_texture_view
get_queue
create_shader_module
create_command_encoder
create_render_pipeline_simple
begin_render_pass
finish_encoder
queue_submit
end_pass
set_pipeline
draw
