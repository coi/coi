// schema_whitelist.def
// Purpose: Explicitly allow these WebCC functions to be exposed to Coi
// This is the "single source of truth" for the public Coi API.
//
// Format:
//   [namespace]
//   [Type]                     - @intrinsic/@inline defs for one handle type
//   function_name              - Regular webcc function (auto-generates @map)
//   // comment                 - Preserved comment (emitted before next @intrinsic/@inline)
//   @intrinsic("x") def ...    - Raw intrinsic definition (emitted as-is)
//   @inline("x") def ...       - Raw inline definition (emitted as-is)

[dom]
set_property
# +listen makes these view attributes
remove_pointer_listener
add_pointer_listener +listen(POINTER) flags=1
add_wheel_listener +listen(WHEEL) flags=1
observe_resize +listen(RESIZE)
add_scroll_listener +listen(SCROLL)
remove_scroll_listener
add_focus_listener +listen(FOCUS, BLUR)
add_drop_listener +listen(DROP)
# text boxes over a canvas
set_style
set_inner_html
focus
blur
get_property
request_fullscreen
request_pointer_lock
scroll_to_top
exec_command
focus_end

[canvas]
create_canvas
# the canvas as a data: URL, for thumbnails
to_data_url
get_context_webgl
get_context_webgpu
set_size
free
log_canvas_info
set_fill_style
set_fill_style_str
fill_rect
clear_rect
stroke_rect
set_stroke_style
set_stroke_style_str
set_line_width
begin_path
close_path
move_to
line_to
stroke
fill
arc
fill_text
fill_text_f
fill_text_i
set_font
set_text_align
draw_image
translate
rotate
scale
save
restore
set_global_alpha
set_line_cap
set_line_join
set_shadow
bezier_curve_to
quadratic_curve_to
rect
clip
stroke_text
set_text_baseline
draw_image_scaled
draw_image_full
set_global_composite_operation
transform
set_miter_limit
set_image_smoothing_enabled
measure_text_width
measure_text
ellipse
arc_to
set_line_dash
get_line_dash
reset_transform
set_transform

[audio]
create_audio
@inline("webcc::audio::create_audio(${0})") shared def load(string src): Audio
play
pause
set_volume
set_loop
get_current_time
get_duration

[image]
# LOADED or ERROR
load +events
from_blob +events
free

[input]
exit_pointer_lock
# block browser shortcuts like Ctrl+S
prevent_key
allow_key
# Input.onKeyDown / onKeyUp
init_keyboard +listen(KEY_DOWN, KEY_UP)
// Keyboard state queries (compiler intrinsics)
@intrinsic("key_down") shared def isKeyDown(int keyCode): bool
@intrinsic("key_up") shared def isKeyUp(int keyCode): bool

[storage]
set_item
get_item
remove_item
clear

[fetch]
# DONE needs bytes, only on request()
get +events(SUCCESS, ERROR)
post +events(SUCCESS, ERROR)
patch +events(SUCCESS, ERROR)
# any method, binary body
request +events(DONE, ERROR)
abort

[system]
# frames on demand, screen, connection
get_device_pixel_ratio
is_online
# page lifecycle, PAGE_HIDE is the last chance to save
init_lifecycle +listen(PAGE_HIDE, PAGE_SHOW, ONLINE)
init_visibility_change +listen(VISIBILITY_CHANGE)
log
warn
error
set_title
reload
open_url
get_time
get_date_now
get_timezone_offset_ms
# one-shot timer: System.setTimeout(ms, &fired) returns a Timeout, timeout.clearTimeout() cancels
set_timeout +events(TIMER)
clear_timeout
get_pathname
get_search
get_query_param
get_visibility_state
# for app { tick = demand; }
request_frame
@intrinsic("is_hidden") shared def isHidden(): bool
// Router navigation (compiler intrinsics)
@intrinsic("navigate") shared def navigate(string route): void
@intrinsic("get_route") shared def getRoute(): string

[webgl]
viewport
clear_color
clear
create_shader
create_program
attach_shader
link_program
bind_attrib_location
use_program
create_buffer
bind_buffer
buffer_data
enable_vertex_attrib_array
enable
get_uniform_location
uniform_1f
vertex_attrib_pointer
draw_arrays

[Canvas]
// 2D context, lowLatency cuts pen lag, opaque skips alpha
@inline("webcc::canvas::get_context_2d(${this})") def getContext2d(): CanvasContext2D
@inline("webcc::canvas::get_context_2d(${this}, webcc::canvas::ContextFlags((${0} ? 1 : 0) | (${1} ? 2 : 0)))") def getContext2d(bool lowLatency, bool opaque): CanvasContext2D

[blob]
# bytes held on the JS side: read() keeps them, take() frees
create
size
read
take
free

[idb]
# key-value store, results arrive on the returned request
open +events
put +events(DONE, ERROR)
get +events(VALUE, ERROR)
remove +events(DONE, ERROR)
keys +events(KEYS, ERROR)
close

[clipboard]
# write_text only works in a click or key handler
write_text
# pastes outside text fields
init_paste +listen(PASTE_TEXT, PASTE_IMAGE) prevent_default=1
# every paste, editors too, as html and text
init_paste_rich +listen(PASTE_RICH)

[files]
# needs a click or key handler, one OPENED per file
open +events
save

[pdf]
# import needs Pdf.setLibrary first
set_library
open +events
page_width
page_height
render_page +events
cancel_render
close
create_writer +events
add_page
set_stroke_color
set_fill_color
set_line_width
set_line_cap
set_line_join
move_to
line_to
quad_to
curve_to
rect
close_path
stroke
fill
save
restore
draw_image
draw_text
finish

[websocket]
# owned sockets close on destroy
@cleanup("websocket::close")
connect +events
send
close
get_ready_state
send_binary
close_with_code
get_buffered_amount
get_protocol
get_extensions
get_url
// true while open
@inline("(webcc::websocket::get_ready_state($self) == webcc::websocket::ReadyState::OPEN)") def isConnected(): bool

[wgpu]
request_adapter
request_device
configure
get_current_texture_view
get_queue
create_shader_module
create_command_encoder
create_render_pipeline_simple
begin_render_pass
finish_encoder
queue_submit
end_pass
set_pipeline
draw
