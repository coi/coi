// a wrong expectation fails the run and says what it saw; the test after it still runs
module Failing;

def twice(int x) : int { return x * 2; }

test "the first check holds, the second does not" {
    expect(twice(2) == 4);
    expect(twice(3) == 7);
}

test "this one passes" {
    expect(twice(0) == 0);
}
