// every kind of value a test compares
module Values;

pod Point { int x; int y; }
enum Mode { Idle, Busy }

def origin() : Point { return Point{x = 0, y = 0}; }
def shift(Point p, int by) : Point { return Point{x = p.x + by, y = p.y + by}; }
def letters(string s) : string[] {
    mut string[] out;
    for i in 0:s.length() out.push(s.subStr(i, 1));
    return out;
}

test "ints, floats and strings" {
    expect(1 + 1 == 2);
    expect(0.5 * 2.0 == 1.0);
    expect("a" + "b" == "ab");
    expect(2 < 3);
    expect(3 >= 3);
}

test "bools and negation" {
    expect(true);
    expect(!"abc".isEmpty());
    expect("abc".contains("b") && !"abc".contains("z"));
}

test "pods by value" {
    expect(shift(origin(), 2) == Point{x = 2, y = 2});
    expect(shift(origin(), 2) != origin());
}

test "enums" {
    Mode m = Mode::Busy;
    expect(m == Mode::Busy);
    expect(m != Mode::Idle);
}

test "arrays by element" {
    expect(letters("abc") == ["a", "b", "c"]);
    expect([3, 1, 2].filter(x => x > 1) == [3, 2]);
    expect([1, 2].size() == 2);
    int[] empty;
    expect(empty == []);
}

test "maps and locals" {
    mut int[string] m;
    m["a"] = 1;
    expect(m["a"] == 1);
    expect(m.contains("a"));
    mut int sum = 0;
    for i in 0:4 sum += i;
    expect(sum == 6);
}
