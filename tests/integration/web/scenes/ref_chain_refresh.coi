// a shared pod by reference through three levels: a write at the top (from a click and from
// a key) must reach the bottom view; a write at the bottom must reach the top
pod Shared { int n; string mode; }

component Leaf(mut Shared& common, def onBump : void) {
    def bump() : void { common.n++; onBump(); }
    def label() : string { return common.mode == "on" ? "leaf on" : "leaf off"; }
    view { <div><p class="leaf-n">{common.n}</p><p class="leaf-mode">{label()}</p><button class="leaf-bump" onclick={bump}>bump</button></div> }
}

component Mid(mut Shared& common) {
    pub mut Leaf leaf = Leaf(&common, &bumped);
    mut int bumps = 0;
    def bumped() : void { bumps++; }
    view { <div><p class="mid-n">{common.n}</p><for i in 0:common.n><span class="mid-item">x</span></for><{leaf} /></div> }
}

component App {
    mut Shared common = Shared{n = 1, mode = "off"};
    mut Mid mid = Mid(&common);
    mount { Input.onKeyDown(&key); }
    def key(KeyDownEvent e) : void { if (e.key == "m") common.mode = common.mode == "on" ? "off" : "on"; }
    def add() : void { common.n++; }
    view { <div><p class="top-n">{common.n}</p><button class="top-add" onclick={add}>add</button><{mid} /></div> }
}

app { root = App; }
