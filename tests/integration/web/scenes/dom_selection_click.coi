// a contenteditable's own nodes: the clicked one (onclicktarget), the caret's (getSelectionAnchor),
// closest/contains on them, classes set on them, isValid on call results
component App {
    mut DOMElement ed;
    mut string log = "";

    def clicked(DOMElement t, float x, float y, Mods m) : void {
        DOMElement li = t.closest("li");
        if (!li.isValid() || ed.contains(li) == 0) { log = "outside"; return; }
        if (li.getProperty("className").contains("done")) li.removeClass("done");
        else li.addClass("done");
        log = `${t.getProperty("tagName")} ${x < 30.0 ? "left" : "right"} ${(m & Mods.Shift) != 0 ? "shift" : "plain"}`;
    }

    def where() : void {
        DOMElement a = DOMElement.getSelectionAnchor();
        string inEd = a.isValid() && ed.contains(a) == 1 ? "in" : "out";
        log = `${inEd} ${a.closest("b").isValid() ? "bold" : "plain"} [${Dom.getSelectionText()}]`;
    }

    mount { ed.setInnerHtml("<ul><li id=\"one\">one</li><li id=\"two\">two <b id=\"b\">bold</b></li></ul>"); }

    view {
        <div>
            <div &={ed} class="ed" contenteditable="true" onclicktarget={clicked}></div>
            <button class="where" onclick={where}>where</button>
            <p class="log">{log}</p>
        </div>
    }
}
app { root = App; }
