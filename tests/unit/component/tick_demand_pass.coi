// Test: tick = demand
component TickDemandPass {
    mut float alpha = 1.0;
    mut bool fading = false;

    def startFade() : void {
        fading = true;
        System.requestFrame();
    }

    tick(float dt) {
        if (fading) {
            alpha -= dt;
            if (alpha <= 0.0) {
                alpha = 0.0;
                fading = false;
            } else {
                System.requestFrame();
            }
        }
    }

    view {
        <button onclick={startFade}>{alpha}</button>
    }
}

app {
    root = TickDemandPass;
    tick = demand;
}
