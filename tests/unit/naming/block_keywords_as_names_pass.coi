// Test: style, view, mount, tick and init are only keywords at the start of a component
// member, so they can name variables, parameters and fields, with built-in or own types

pod Spot { int x; int view; }

component Card(string style, int view = 0) {
    mut string mount = "top";
    mut int tick = 0;
    mut bool init = false;

    def describe(string style) : string {
        mut string view = style + "/" + mount;
        tick++;
        init = true;
        return view;
    }

    def spots() : int {
        mut Spot tick = Spot{x = 1, view = 0};
        tick.view = 2;
        mut Spot[] key = [tick];
        key[0].x = 3;
        Spot& init = key[0];
        return tick.x + tick.view + init.x + key.size();
    }

    style {
        .card { padding: 4px; }
    }

    view {
        <div class="card">{describe(style)} {view} {tick} {spots()}</div>
    }
}

component App {
    view {
        <Card style="plain" view={2} />
    }
}

app {
    root = App;
}
