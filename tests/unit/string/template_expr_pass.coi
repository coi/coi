// Test: template parts are full expressions
component App {
    mut string s = "";
    mut int a = 3;
    mut string[] xs = ["q"];
    init {
        s = `pi ${Math.PI} sin ${Math.sin(1.0)} n ${xs.size()} x ${xs[0].length()} t ${a > 2 ? "big" : "small"} nest ${`in ${a}`} ${"}"}`;
    }
    view { <p>{s}</p> }
}

app { root = App; }
