// Test: page-wide events
component PageEventsPass {
    mut Database db;
    mut PdfDocument doc;
    mut Compression zip;
    mut Image img;
    mut Canvas surface;
    mut FileRequest pick;
    mut string text = "";
    mut int n = 0;

    def pasted(string t) : void { text = t; }
    def pastedImage(Blob image, string mime) : void { img = Image.fromBlob(image, mime); image.free(); }
    def keyPressed(KeyDownEvent k) : void { n = k.keyCode; }
    def hidden() : void { n = 0; }
    def online(uint8 up) : void { n = up == 1 ? 1 : 0; }
    def opened(int pages, string error) : void { n = pages; doc.renderPage(0, surface, 2.0); }
    def deflated(Blob data, string error) : void { uint8[] bytes = data.take(); Files.save("notes.z", "application/zlib", bytes); }
    def picked(Blob data, string name) : void { doc = PdfDocument.open(data, &onOpened = opened); data.free(); }
    def done(int status, Blob body) : void { body.free(); }

    def importPdf() : void { pick = FileRequest.open(".pdf", 0, &onOpened = picked); }

    def exportPdf() : void {
        mut CanvasContext2D c = surface.getContext2d();
        uint8[] px = c.getImageData(0, 0, 10, 10);
        zip = Compression.compress(px, "deflate", &onDone = deflated);
    }

    mount {
        Clipboard.onPasteText(&pasted);
        Clipboard.onPasteImage(&pastedImage);
        Input.onKeyDown(&keyPressed);
        System.onPageHide(&hidden);
        System.onOnline(&online);
        Pdf.setLibrary("assets/pdf.min.mjs", "assets/pdf.worker.min.mjs");
        db = Idb.open("x");
        db.close();
        FetchRequest.request("PUT", "/sync", "", [1, 2, 3], &onDone = done);
        bool up = System.isOnline() == 1;
    }

    view { <canvas &={surface} onclick={exportPdf}></canvas> }
}
app { root = PageEventsPass; }
