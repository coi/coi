// Test: a JavaScript body with a callback - it calls back with a string, later too

def countTo(int n, def onTick(string) : void) : void = js {
    let i = 0;
    const id = setInterval(() => { i++; onTick("tick " + i); if (i >= n) clearInterval(id); }, 10);
}

component App {
    mut string last = "";

    def heard(string msg) : void {
        last = msg;
    }

    mount {
        countTo(3, &onTick = heard);
    }

    view {
        <div>{last}</div>
    }
}

app {
    root = App;
}
