namespace coi {
using string = webcc::string;
using string_view = webcc::string_view;
template<typename T> using vector = webcc::vector<T>;
}
inline coi::vector<uint8_t> coi_bytes(webcc::bytes_view v) {
    coi::vector<uint8_t> out; out.reserve(v.length());
    for (uint32_t i = 0; i < v.length(); i++) out.push_back(v.data()[i]);
    return out;
}
namespace coi {
