template<typename K, typename V> using map = webcc::unordered_map<K, V>;
template<typename Signature> using function = webcc::function<Signature>;
using webcc::move;
template<typename F> struct OnExit { F f; ~OnExit() { f(); } };
template<typename F> OnExit<F> on_exit(F f) { return OnExit<F>{f}; }
