// Cast helpers backing the builtin toInt/toFloat/toString methods.
// Overloaded so one inline template stays valid for any receiver type.
inline int to_int(const string& s) { return s.to_int(); }
inline int to_int(double v) { return (int)v; }
inline int to_int(float v) { return (int)v; }
inline int to_int(int v) { return v; }
inline int to_int(unsigned int v) { return (int)v; }
inline int to_int(long v) { return (int)v; }
inline int to_int(unsigned long v) { return (int)v; }
inline int to_int(long long v) { return (int)v; }
inline int to_int(unsigned long long v) { return (int)v; }
inline double to_float(const string& s) { return s.to_float(); }
inline double to_float(double v) { return v; }
inline double to_float(float v) { return (double)v; }
inline double to_float(int v) { return (double)v; }
inline double to_float(unsigned int v) { return (double)v; }
inline double to_float(long v) { return (double)v; }
inline double to_float(unsigned long v) { return (double)v; }
inline double to_float(long long v) { return (double)v; }
inline double to_float(unsigned long long v) { return (double)v; }
inline vector<uint8_t> string_to_bytes(const string& s) { vector<uint8_t> v; v.reserve(s.length()); for (uint32_t i = 0; i < s.length(); i++) v.push_back((uint8_t)s.data()[i]); return v; }
inline string string_from_bytes(const vector<uint8_t>& b) { return b.size() ? string((const char*)&b[0], (uint32_t)b.size()) : string(); }
inline string to_string(const string& s) { return s; }
inline string to_string(bool v) { return string(v ? "true" : "false"); }
template<typename T> inline string to_string(T v) { webcc::formatter<32> f; f << v; return string(f.c_str()); }
}

struct DispatcherBase {
    static inline DispatcherBase* g_first = nullptr;
    DispatcherBase* next = nullptr;
    void (*forget)(DispatcherBase*, const void*) = nullptr;
    void (*forget_handle)(DispatcherBase*, webcc::handle) = nullptr;
};
template<typename Callback, int MaxListeners = 512>
struct Dispatcher : DispatcherBase {
    int32_t handles[MaxListeners];
    Callback callbacks[MaxListeners];
    const void* owners[MaxListeners];
    int count = 0;
    void set(webcc::handle h, Callback cb, const void* owner = nullptr) {
        if (!forget) {
            forget = [](DispatcherBase* b, const void* o) { static_cast<Dispatcher*>(b)->remove_owner(o); };
            forget_handle = [](DispatcherBase* b, webcc::handle h) { static_cast<Dispatcher*>(b)->remove(h); };
            next = g_first; g_first = this;
        }
        int32_t hid = (int32_t)h;
        for (int i = 0; i < count; i++) {
            if (handles[i] == hid) { callbacks[i] = cb; owners[i] = owner; return; }
        }
        if (count < MaxListeners) {
            handles[count] = hid;
            callbacks[count] = cb;
            owners[count] = owner;
            count++;
        }
    }
    void remove_owner(const void* owner) {
        for (int i = 0; i < count; ) {
            if (owners[i] == owner) {
                handles[i] = handles[count-1];
                callbacks[i] = callbacks[count-1];
                owners[i] = owners[count-1];
                count--;
            } else { i++; }
        }
    }
    void remove(webcc::handle h) {
        int32_t hid = (int32_t)h;
        for (int i = 0; i < count; i++) {
            if (handles[i] == hid) {
                handles[i] = handles[count-1];
                callbacks[i] = callbacks[count-1];
                owners[i] = owners[count-1];
                count--;
                return;
            }
        }
    }
    template<typename... Args>
    bool dispatch(webcc::handle h, Args&&... args) {
        int32_t hid = (int32_t)h;
        for (int i = 0; i < count; i++) {
            if (handles[i] == hid) { callbacks[i](args...); return true; }
        }
        return false;
    }
    template<typename... Args>
    void dispatch_all(Args&&... args) {
        int n = count;
        for (int i = 0; i < n && i < count; i++) callbacks[i](args...);
    }
};
template<typename E> Dispatcher<coi::function<void(const E&)>> coi_events;
inline void coi_forget_owner(const void* owner) {
    for (DispatcherBase* d = DispatcherBase::g_first; d; d = d->next) d->forget(d, owner);
}
inline void coi_forget_handle(webcc::handle h) {
    for (DispatcherBase* d = DispatcherBase::g_first; d; d = d->next) d->forget_handle(d, h);
}

int g_view_depth = 0;

struct PointerType {
    enum _V : uint8_t { Mouse, Pen, Touch, _COUNT };
    _V v;
    constexpr PointerType(_V x = (_V)0) : v(x) {}
    constexpr PointerType(int x) : v((_V)x) {}
    constexpr operator int() const { return v; }
};
struct LineJoin {
    enum _V : uint8_t { Miter, Round, Bevel, _COUNT };
    _V v;
    constexpr LineJoin(_V x = (_V)0) : v(x) {}
    constexpr LineJoin(int x) : v((_V)x) {}
    constexpr operator int() const { return v; }
};
struct LineCap {
    enum _V : uint8_t { Butt, Round, Square, _COUNT };
    _V v;
    constexpr LineCap(_V x = (_V)0) : v(x) {}
    constexpr LineCap(int x) : v((_V)x) {}
    constexpr operator int() const { return v; }
};
struct PointerPhase {
    enum _V : uint8_t { Down, Move, Up, Cancel, Predicted, _COUNT };
    _V v;
    constexpr PointerPhase(_V x = (_V)0) : v(x) {}
    constexpr PointerPhase(int x) : v((_V)x) {}
    constexpr operator int() const { return v; }
};
struct ReadyState {
    enum _V : uint8_t { Connecting, Open, Closing, Closed, _COUNT };
    _V v;
    constexpr ReadyState(_V x = (_V)0) : v(x) {}
    constexpr ReadyState(int x) : v((_V)x) {}
    constexpr operator int() const { return v; }
};

struct Row {
    int32_t id;
    coi::string kind;
};
struct RenderedEvent {
    uint8_t ok;
    coi::string error;
};
struct KeyDownEvent {
    int32_t keyCode;
    uint8_t mods;
    uint8_t repeat;
    coi::string key;
};
struct PasteRichEvent {
    coi::string html;
    coi::string text;
    uint8_t inEditor;
};
struct LoadedEvent {
    int32_t width;
    int32_t height;
};
struct ScrollEvent {
    float left;
    float top;
};
struct KeyUpEvent {
    int32_t keyCode;
    uint8_t mods;
    coi::string key;
};
struct OpenedEvent {
    int32_t pageCount;
    coi::string error;
};
struct WheelEvent {
    float deltaX;
    float deltaY;
    float x;
    float y;
    uint8_t mods;
};
struct VisibilityChangeEvent {
    uint8_t hidden;
    coi::string state;
};
struct CloseEvent {
    int32_t code;
    coi::string reason;
    uint8_t wasClean;
};
