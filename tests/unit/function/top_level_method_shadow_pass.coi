// Test: method shadows top-level function
def pick(string a, string b) : string {
    return a;
}

component App {
    mut int value = 0;

    def pick() : int {
        return 42;
    }

    init {
        int v = pick();
        value = v;
    }

    view {
        <div>{value} {pick()}</div>
    }
}

app {
    root = App;
}
